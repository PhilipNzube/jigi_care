{
  "expo": {
    "name": "Jigi Care",
    "slug": "jigicare",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app_icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "com.jigicare.app",
    "splash": {
      "image": "./assets/images/splash_img.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      "./plugins/withAbiSplits",
      [
        "expo-callkit-telecom",
        {}
      ],
      "@react-native-firebase/app",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.326138021655-4tnvd4k857q8lipkcpu4k9ka73617cmg"
        }
      ],
      [
        "onesignal-expo-plugin",
        {
          "mode": "development"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 35,
            "buildToolsVersion": "36.0.0",
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": false,
      "bundleIdentifier": "com.jigicare.app",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to allow you to take photos for your consultations and share them in chat.",
        "NSPhotoLibraryUsageDescription": "This app accesses your photos to allow you to upload images for your consultations and share them in chat.",
        "NSMicrophoneUsageDescription": "This app uses the microphone for video and voice calls with doctors."
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app_icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.jigicare.app",
      "versionCode": 5,
      "screenOrientation": "portrait",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "ACCESS_NETWORK_STATE",
        "BLUETOOTH_CONNECT",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "BIND_TELECOM_CONNECTION_SERVICE",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_PHONE_CALL",
        "READ_PHONE_STATE",
        "CALL_PHONE",
        "READ_PHONE_NUMBERS",
        "MANAGE_OWN_CALLS",
        "USE_FULL_SCREEN_INTENT",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/images/app_icon.png"
    }
  }
}
