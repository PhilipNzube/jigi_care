{
  "expo": {
    "name": "JigiCare",
    "slug": "jigicare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app_icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "com.jijicare.app",
    "splash": {
      "image": "./assets/images/splash_img.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
